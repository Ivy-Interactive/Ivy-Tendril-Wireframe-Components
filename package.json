{
  "name": "tendril-wireframes",
  "version": "0.1.4",
  "description": "Hand-drawn (Balsamiq-style) React component library mirroring the Ivy Framework widget set.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ivy-Interactive/Ivy-Tendril-Wireframe-Components.git"
  },
  "homepage": "https://github.com/Ivy-Interactive/Ivy-Tendril-Wireframe-Components#readme",
  "bugs": {
    "url": "https://github.com/Ivy-Interactive/Ivy-Tendril-Wireframe-Components/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/tendril.css",
    "./theme.css": "./dist/theme.css",
    "./manifest.yaml": "./dist/tendril.manifest.yaml",
    "./manifest.json": "./dist/tendril.manifest.json"
  },
  "files": [
    "dist",
    "tendril.manifest.yaml"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "build": "tsc -b tsconfig.build.json && vite build && npm run manifest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "tsc -p tsconfig.test.json --noEmit && node --experimental-strip-types --test tests/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "manifest": "node scripts/generate-manifest.mjs",
    "manifest:check": "node scripts/generate-manifest.mjs --check"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.475.0",
    "react-day-picker": "^9.5.1",
    "roughjs": "^4.6.6",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^9.0.0",
    "@storybook/react-vite": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^9.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.0",
    "yaml": "^2.9.0"
  }
}
